# Copy this file to .env and fill in real values before running in production.

# Required for face-auth accounts and for the hand-gesture canvas "Save" feature
# to persist. Without this, /api/gesture/work returns 503 with code
# DB_NOT_CONFIGURED, and the app falls back to keeping work only in the
# browser's localStorage on that one device.
MONGO_URI=mongodb://localhost:27017/signspace

# Signs the auth session cookie. Must be set to a long random value in production.
JWT_SECRET=change-me-in-production

# Base URL of the Python AI microservice (ai-service/) used for face auth.
PYTHON_AI_URL=http://localhost:8000

# Public URL of this app, used for CORS / cookie settings.
FRONTEND_URL=http://localhost:3000

PORT=3000
NODE_ENV=development
